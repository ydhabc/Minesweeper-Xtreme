<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#313E4F" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/accentGold" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/buttonQuiet" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#3B4858" />
        </shape>
    </item>
</selector>
