<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/optionChecked" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accentGold" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/optionIdle" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#415166" />
        </shape>
    </item>
</selector>
