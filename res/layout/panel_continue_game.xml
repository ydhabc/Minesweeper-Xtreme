<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/continue_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txt_continue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/accentGold"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_continue_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/textWarm"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前进度详细"
                android:textColor="@color/accentGold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_continue_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="7dp"
                android:textColor="@color/textWarm"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_continue_resume"
            style="@style/XtremeButton"
            android:layout_marginTop="32dp"
            android:text="继续游戏" />

        <Button
            android:id="@+id/btn_continue_restart"
            style="@style/QuietButton"
            android:layout_marginTop="12dp"
            android:text="以相同设置重新开始" />

        <Button
            android:id="@+id/btn_continue_cancel"
            style="@style/QuietButton"
            android:layout_marginTop="10dp"
            android:text="先回主页" />
    </LinearLayout>
</ScrollView>