<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bgDeep"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_settings_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textWarm"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_back_menu"
                style="@style/SmallButton"
                android:layout_marginLeft="14dp"
                android:text="返回" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="确认挑战条件，阅读当前模式规则后开始。"
            android:textColor="@color/textMuted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="挑战设置"
                android:textColor="@color/accentGold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/check_step_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/check_option_bg"
                android:buttonTint="@color/accentGold"
                android:layout_marginBottom="12dp"
                android:padding="14dp"
                android:text="开启单步计时 (固定60秒)"
                android:textColor="@color/textWarm"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/check_expert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/check_option_bg"
                android:buttonTint="@color/accentGold"
                android:padding="14dp"
                android:text="开启专家模式"
                android:textColor="@color/textWarm"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前模式规则"
                android:textColor="@color/accentGold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/textWarm"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_start_game"
            style="@style/XtremeButton"
            android:layout_marginTop="28dp"
            android:text="开始游戏" />

    </LinearLayout>
</ScrollView>
