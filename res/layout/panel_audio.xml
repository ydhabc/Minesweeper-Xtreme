<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/audio_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <Button android:id="@+id/btn_audio_back" style="@style/SmallButton" android:text="返回"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="音频设置" android:textColor="@color/textWarm" android:textSize="24sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="18dp">
            <CheckBox android:id="@+id/check_mute" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/check_option_bg" android:buttonTint="@color/accentGold" android:padding="12dp" android:text="静音" android:textColor="@color/textWarm" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/txt_home_volume" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/accentGold" android:textSize="15sp" android:textStyle="bold"/>
            <SeekBar android:id="@+id/seek_home_volume" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/txt_game_volume" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/accentGold" android:textSize="15sp" android:textStyle="bold"/>
            <SeekBar android:id="@+id/seek_game_volume" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="音乐会根据当前页面自动切换主页/游戏音量。" android:textColor="@color/textMuted" android:textSize="13sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="请把主页音乐放到 app/src/main/res/raw/bgm_home.mp3，把游戏内音乐放到 app/src/main/res/raw/bgm_game.mp3；只有一首时也可直接放 bgm.mp3" android:textColor="@color/textMuted" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
