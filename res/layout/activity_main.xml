<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgDeep"
    tools:context="com.ydh.minesweeper_xtreme.MainActivity">

    <ScrollView
        android:id="@+id/menu_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_title"
                android:textColor="@color/textWarm"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/app_subtitle"
                android:textColor="@color/textMuted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_normal"
                style="@style/XtremeButton"
                android:layout_marginTop="36dp"
                android:text="普通模式" />

            <Button
                android:id="@+id/btn_2h"
                style="@style/XtremeButton"
                android:text="变体一：水平双雷 (2H)" />

            <Button
                android:id="@+id/btn_2d"
                style="@style/XtremeButton"
                android:text="变体二：骨牌雷 (2D)" />

            <Button
                android:id="@+id/btn_2g"
                style="@style/XtremeButton"
                android:text="变体三：2x2雷块 (2G)" />

            <Button
                android:id="@+id/btn_scores"
                style="@style/XtremeButton"
                android:text="历史最高分" />

            <Button
                android:id="@+id/btn_rules"
                style="@style/QuietButton"
                android:layout_marginTop="16dp"
                android:text="查看规则" />

            <Button
                android:id="@+id/btn_audio"
                style="@style/QuietButton"
                android:text="音频设置" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btn_back_menu"
                style="@style/SmallButton"
                android:text="返回" />

            <TextView
                android:id="@+id/txt_settings_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/textWarm"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <CheckBox
                    android:id="@+id/check_step_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/check_option_bg"
                    android:buttonTint="@color/accentGold"
                    android:padding="12dp"
                    android:text="开启单步计时（固定60秒）"
                    android:textColor="@color/textWarm"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/check_expert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/check_option_bg"
                    android:buttonTint="@color/accentGold"
                    android:padding="12dp"
                    android:text="开启专家模式"
                    android:textColor="@color/textWarm"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当前模式规则"
                    android:textColor="@color/accentGold"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_rule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/textWarm"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_start_game"
                style="@style/XtremeButton"
                android:layout_marginTop="24dp"
                android:text="开始游戏" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/rules_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btn_rules_back"
                style="@style/SmallButton"
                android:text="返回" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="规则说明"
                android:textColor="@color/textWarm"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_rules_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/panel_bg"
                android:lineSpacingExtra="6dp"
                android:padding="18dp"
                android:textColor="@color/textWarm"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/audio_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btn_audio_back"
                style="@style/SmallButton"
                android:text="返回" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="音频设置"
                android:textColor="@color/textWarm"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <CheckBox
                    android:id="@+id/check_mute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/check_option_bg"
                    android:buttonTint="@color/accentGold"
                    android:padding="12dp"
                    android:text="静音"
                    android:textColor="@color/textWarm"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_home_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/accentGold"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek_home_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txt_game_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/accentGold"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek_game_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="音乐会根据当前页面自动切换主页/游戏音量。"
                    android:textColor="@color/textMuted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="请把主页音乐放到 app/src/main/res/raw/bgm_home.mp3，把游戏内音乐放到 app/src/main/res/raw/bgm_game.mp3；只有一首时也可直接放 bgm.mp3"
                    android:textColor="@color/textMuted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/game_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_game_back"
                style="@style/SmallButton"
                android:text="主页" />

            <Button
                android:id="@+id/btn_pause"
                style="@style/SmallButton"
                android:layout_marginLeft="8dp"
                android:text="暂停" />

            <TextView
                android:id="@+id/txt_game_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:gravity="right"
                android:textColor="@color/textWarm"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txt_status_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textWarm"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txt_timer_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/textMuted"
                android:textSize="14sp" />
        </LinearLayout>

        <com.ydh.minesweeper_xtreme.BoardView
            android:id="@+id/board_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txt_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/textWarm"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_restart"
            style="@style/QuietButton"
            android:layout_marginTop="10dp"
            android:text="重新开始本局设置" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgDeep"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_result_toggle_map"
            style="@style/ResultPeekButton"
            android:layout_gravity="end"
            android:layout_marginBottom="10dp"
            android:text="看雷图" />

        <LinearLayout
            android:id="@+id/result_summary_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/accentGold"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_result_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="20dp"
                android:textColor="@color/textWarm"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btn_result_restart"
                style="@style/XtremeButton"
                android:layout_marginTop="20dp"
                android:text="再来一局" />

            <Button
                android:id="@+id/btn_result_menu"
                style="@style/XtremeButton"
                android:text="返回主页" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
