<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_title"
            android:textColor="@color/textWarm"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/app_subtitle"
            android:textColor="@color/textMuted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_normal"
            style="@style/XtremeButton"
            android:layout_marginTop="36dp"
            android:text="普通模式" />

        <Button
            android:id="@+id/btn_2h"
            style="@style/XtremeButton"
            android:text="变体一：水平双雷 (2H)" />

        <Button
            android:id="@+id/btn_2d"
            style="@style/XtremeButton"
            android:text="变体二：骨牌雷 (2D)" />

        <Button
            android:id="@+id/btn_2g"
            style="@style/XtremeButton"
            android:text="变体三：2x2雷块 (2G)" />

        <Button
            android:id="@+id/btn_scores"
            style="@style/XtremeButton"
            android:text="历史记录" />

        <Button
            android:id="@+id/btn_rules"
            style="@style/QuietButton"
            android:layout_marginTop="16dp"
            android:text="查看规则" />

        <Button
            android:id="@+id/btn_audio"
            style="@style/QuietButton"
            android:text="音频设置" />
    </LinearLayout>
</ScrollView>
